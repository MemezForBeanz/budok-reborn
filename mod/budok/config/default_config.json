{
  "version": 1,
  "mcp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8765,
    "auth_token": "",
    "require_token": true,
    "allowed_origins": [],
    "max_wait_s": 25
  },
  "controllers": {
    "p1": "human",
    "p2": "mcp"
  },
  "turns": {
    "forced_turns": "skip_unless_hurt",
    "timeout_s": {"mcp": 0, "ai": 120, "decision": 120, "tandem": 180},
    "fallback_action": "Continue",
    "hide_bot_panel": true,
    "history_length": 12
  },
  "ai": {
    "providers": {
      "anthropic": {"api_key": "", "api_key_env": "ANTHROPIC_API_KEY", "base_url": "https://api.anthropic.com"},
      "openai": {"api_key": "", "api_key_env": "OPENAI_API_KEY", "base_url": "https://api.openai.com/v1"},
      "openrouter": {"api_key": "", "api_key_env": "OPENROUTER_API_KEY", "base_url": "https://openrouter.ai/api/v1"},
      "local": {"api_key": "", "api_key_env": "", "base_url": "http://127.0.0.1:11434/v1"},
      "vercel": {"api_key": "", "api_key_env": "AI_GATEWAY_API_KEY", "base_url": "https://ai-gateway.vercel.sh/v4/ai"},
      "typesafe": {"api_key": "", "api_key_env": "TYPESAFE_API_KEY", "base_url": "https://api.typesafe.ai"}
    },
    "play": {
      "provider": "anthropic",
      "model": "claude-opus-5-5",
      "effort": "low",
      "max_tokens": 16000,
      "temperature": null,
      "request_timeout_s": 180,
      "max_steps": 6,
      "allow_simulation": true,
      "max_simulations": 3,
      "memory_turns": 6,
      "reflect_after_match": true,
      "style": "",
      "risk": "balanced",
      "refusal_fallback": true,
      "extra_body": {}
    },
    "decide": {
      "pick": "sample"
    },
    "core": {
      "endpoints": [
        {"label": "Jev", "provider": "typesafe", "model": "jev-latest", "api_key": "", "threads": 4, "max_rpm": 0, "enabled": true}
      ],
      "depth": 10,
      "candidates": 4,
      "max_options": 48,
      "think_s": 30,
      "request_timeout_s": 20,
      "frame_budget_ms": 12
    },
    "annotate": {
      "provider": "anthropic",
      "model": "claude-opus-5-5",
      "effort": "high",
      "max_tokens": 16000,
      "temperature": null,
      "request_timeout_s": 300,
      "max_steps": 30,
      "batch_size": 10,
      "include_source": true,
      "max_source_chars": 6000,
      "refusal_fallback": true,
      "extra_body": {}
    }
  },
  "simulation": {
    "enabled": true,
    "max_ticks": 120,
    "reuse_previews": true
  },
  "agents": {
    "for_mcp": true,
    "for_bots": false,
    "cli": "claude",
    "command": "",
    "model": "",
    "custom_command": ""
  },
  "schemas": {
    "registry_enabled": false,
    "registry_url": "",
    "auto": {
      "enabled": true,
      "use_agent": true,
      "use_api": true,
      "use_player": false,
      "agent_command": "claude",
      "agent_model": "",
      "when": "matches",
      "match_start": true
    }
  },
  "misc": {
    "speech_bubbles": false,
    "trash_talk": false,
    "bubble_seconds": 4
  },
  "memory": {
    "enabled": true,
    "shown_per_match": 6,
    "max_per_subject": 100
  },
  "source_access": {
    "enabled": true,
    "max_file_bytes": 200000
  },
  "automation": {
    "script": ""
  },
  "ui": {
    "show_button": true,
    "toggle_key": "F8",
    "agent_window_key": "F9",
    "show_on_start": false
  },
  "logging": {
    "verbose": false,
    "match_logs": true
  }
}
